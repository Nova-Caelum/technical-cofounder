{
  "id": "greeting-file",
  "criteria": [
    {
      "statement": "greeting.txt exists",
      "verification": {
        "kind": "file_state",
        "path": "greeting.txt",
        "assertion": "exists"
      }
    },
    {
      "statement": "greeting.txt holds Hello, world",
      "verification": {
        "kind": "file_state",
        "path": "greeting.txt",
        "assertion": "contains",
        "expected": "Hello, world"
      }
    }
  ]
}

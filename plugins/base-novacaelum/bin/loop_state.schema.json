{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "loop.state.json: the machine-readable position of one working-loop run",
  "description": "Written only by loop_state.py. Validated on every save by that script's small draft-07 subset (required, type, enum, properties, items).",
  "type": "object",
  "required": [
    "run_id", "goal_slug", "original_input", "input_hash", "status", "current_node",
    "trail", "artifacts", "gates", "budget", "driver", "kill",
    "descope_decision_ref", "final_route", "escape_rate"
  ],
  "properties": {
    "run_id": {"type": "string"},
    "goal_slug": {"description": "Also the run folder's name.", "type": "string"},
    "original_input": {"description": "The ask, verbatim, set once at init and never rewritten.", "type": "string"},
    "input_hash": {"description": "sha256 of original_input.", "type": "string"},
    "status": {
      "description": "Where the run stands. The four stage names mirror current_node; live is conferred only by the build gate; done, descoped and killed are the only legitimate endings.",
      "type": "string",
      "enum": ["framing", "understand", "decide", "draft", "build", "live", "done", "descoped", "killed"]
    },
    "current_node": {
      "description": "The stage the run is in. It never moves past build: after the build gate, status moves and the node does not.",
      "type": "string",
      "enum": ["framing", "understand", "decide", "draft", "build"]
    },
    "trail": {
      "description": "Every stage entered, oldest first.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node", "entered_at", "exited_at"],
        "properties": {
          "node": {"type": "string"},
          "entered_at": {"type": "string"},
          "exited_at": {"type": ["string", "null"]}
        }
      }
    },
    "artifacts": {
      "description": "Files frozen by a passing gate. path is relative to the run folder when the file lives inside it.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256", "frozen_at", "frozen_by", "node"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string"},
          "frozen_at": {"type": "string"},
          "frozen_by": {"type": "string"},
          "node": {"type": "string"}
        }
      }
    },
    "gates": {
      "description": "One entry per passing gate. A refusal records nothing.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node", "passed", "passed_at"],
        "properties": {
          "node": {"type": "string"},
          "passed": {"type": "boolean"},
          "passed_at": {"type": "string"}
        }
      }
    },
    "budget": {
      "description": "doubled_back_rounds counts edits to frozen artifacts, each edit once. It is the fix-versus-pivot evidence: a run that keeps rewriting its frozen tests or plan is changing its mind, not fixing a bug.",
      "type": "object",
      "required": ["doubled_back_rounds", "doubled_back_events"],
      "properties": {
        "doubled_back_rounds": {"type": "integer"},
        "doubled_back_events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "detected_at"],
            "properties": {"path": {"type": "string"}, "detected_at": {"type": "string"}}
          }
        }
      }
    },
    "driver": {
      "description": "Who was driving at the last recorded approval. confirm requires authority == human.",
      "type": "object",
      "required": ["tier", "human_present", "authority"],
      "properties": {
        "tier": {"type": ["string", "null"]},
        "human_present": {"type": "boolean"},
        "authority": {"type": ["string", "null"]}
      }
    },
    "kill": {
      "type": "object",
      "required": ["fired", "reason"],
      "properties": {"fired": {"type": "boolean"}, "reason": {"type": ["string", "null"]}}
    },
    "descope_decision_ref": {"type": ["string", "null"]},
    "final_route": {"type": ["string", "null"], "enum": ["done", "descoped", "killed", null]},
    "escape_rate": {
      "description": "escaped / (escaped + caught), written once at confirm: defects the person's live test found that the loop's own tests missed.",
      "type": ["number", "null"]
    }
  }
}
